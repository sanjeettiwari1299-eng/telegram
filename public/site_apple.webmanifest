{
    "name": "TG Web A",
    "short_name": "TG Web A",
    "description": "A personal fork of Telegram Web A — fast, secure messaging in your browser.",
    "start_url": "./",
    "gcm_sender_id": "122867383838",
    "icons": [
        {
            "src": "icon-square-192x192.png",
            "sizes": "192x192",
            "type": "image/png"
        },
        {
            "src": "icon-square-384x384.png",
            "sizes": "384x384",
            "type": "image/png"
        },
        {
            "src": "icon-square-512x512.png",
            "sizes": "512x512",
            "type": "image/png"
        }
    ],
    "screenshots": [
        {
            "src": "screenshot.jpg",
            "sizes": "1280x802",
            "type": "image/jpeg"
        }
    ],
    "share_target": {
        "action": "./share/",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url",
            "files": [
                {
                    "name": "files",
                    "accept": "*/*"
                }
            ]
        }
    },
    "theme_color": "#6c4bf6",
    "background_color": "#12102a",
    "display": "standalone"
}
